{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo run -q -p od-cli:*)",
      "Bash(cargo tree:*)",
      "Bash(bun install)",
      "Bash(bun test:*)",
      "Bash(bun run check)",
      "Bash(bun run lint)",
      "Bash(bun run lint:fix)",
      "Bash(bun run format)",
      "Bash(bun run format:check)",
      "Bash(bun run typecheck)",
      "Bash(bun run build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(jq:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh release:*)",
      "Bash(cargo publish:*)",
      "Bash(bun publish:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./**/*.pem)", "Read(./**/id_rsa*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-touched.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
