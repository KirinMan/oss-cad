{
  "$comment": "Air terminals. The connection port faces up (+Z) for ceiling-mounted units, since that is where the branch duct comes from; the visible face is at Z = 0, the ceiling plane.",
  "parts": [
    {
      "id": "duct.terminal.anemostat",
      "name": { "ja": "アネモ型吹出口", "en": "Anemostat diffuser" },
      "category": "duct-terminal",
      "tags": ["diffuser", "アネモ", "吹出口", "SA"],
      "ifc_class": "IfcAirTerminal",
      "source": "generic",
      "parameters": [
        { "name": "SIZE", "label": { "ja": "呼び寸法", "en": "Nominal size" }, "default": 300, "min": 150, "max": 900, "unit": "mm" },
        { "name": "D", "label": { "ja": "接続径", "en": "Neck diameter" }, "default": "max(SIZE * 0.6, 100)", "min": 100, "unit": "mm" },
        { "name": "T", "label": { "ja": "全高", "en": "Depth" }, "default": "SIZE * 0.5", "min": 50, "unit": "mm" }
      ],
      "ports": [{ "name": "in", "origin": [0, 0, "T"], "direction": [0, 0, 1], "profile": { "kind": "round", "d": "D" }, "system_kind": "air" }],
      "symbol2d": [
        {
          "kind": "polyline",
          "points": [
            ["-SIZE / 2", "-SIZE / 2"],
            ["SIZE / 2", "-SIZE / 2"],
            ["SIZE / 2", "SIZE / 2"],
            ["-SIZE / 2", "SIZE / 2"]
          ],
          "closed": true
        },
        { "kind": "circle", "c": [0, 0], "r": "D / 2" },
        { "kind": "line", "a": ["-SIZE / 2", "-SIZE / 2"], "b": ["-D / 2", "-D / 2"] },
        { "kind": "line", "a": ["SIZE / 2", "-SIZE / 2"], "b": ["D / 2", "-D / 2"] },
        { "kind": "line", "a": ["SIZE / 2", "SIZE / 2"], "b": ["D / 2", "D / 2"] },
        { "kind": "line", "a": ["-SIZE / 2", "SIZE / 2"], "b": ["-D / 2", "D / 2"] }
      ],
      "body3d": [{ "kind": "box", "min": ["-SIZE / 2", "-SIZE / 2", 0], "max": ["SIZE / 2", "SIZE / 2", "T"] }],
      "properties": [
        { "name": "size", "label": { "ja": "呼び寸法", "en": "Nominal size" }, "ty": "real", "unit": "mm", "ifc_property": "Pset_AirTerminalTypeCommon.NominalWidth" },
        { "name": "airflow", "label": { "ja": "風量", "en": "Airflow" }, "ty": "real", "unit": "m3/h", "ifc_property": "Pset_AirTerminalTypeCommon.AirFlowrateRange", "default": 300 },
        { "name": "system", "label": { "ja": "系統", "en": "System" }, "ty": "text", "ifc_property": "Pset_DistributionSystem.Name", "default": "SA" }
      ]
    },
    {
