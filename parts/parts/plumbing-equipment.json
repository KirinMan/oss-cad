{
  "$comment": "Plumbing plant. Envelopes are typical for the duty rather than a specific product.",
  "parts": [
    {
      "id": "plumbing.pump.end_suction",
      "name": { "ja": "渦巻ポンプ", "en": "End suction pump" },
      "category": "plumbing-equipment",
      "tags": ["ポンプ", "揚水", "加圧", "pump"],
      "ifc_class": "IfcPump",
      "source": "generic",
      "parameters": [
        { "name": "W", "label": { "ja": "幅", "en": "Width" }, "default": 900, "min": 400, "max": 2500, "unit": "mm" },
        { "name": "L", "label": { "ja": "奥行", "en": "Depth" }, "default": 400, "min": 250, "max": 1200, "unit": "mm" },
        { "name": "H", "label": { "ja": "高さ", "en": "Height" }, "default": 500, "min": 250, "max": 1500, "unit": "mm" },
        { "name": "D", "label": { "ja": "接続口径", "en": "Connection bore" }, "default": 50, "min": 20, "max": 300, "unit": "mm" }
      ],
      "ports": [
        { "name": "suction", "origin": ["-W / 2", 0, "H / 2"], "direction": [-1, 0, 0], "profile": { "kind": "round", "d": "D" }, "system_kind": "water" },
        { "name": "discharge", "origin": [0, 0, "H"], "direction": [0, 0, 1], "profile": { "kind": "round", "d": "D * 0.8" }, "system_kind": "water" },
        { "name": "power", "origin": ["W / 2", 0, "H / 2"], "direction": [1, 0, 0], "profile": { "kind": "terminal" }, "system_kind": "power" }
      ],
      "symbol2d": [
        {
          "kind": "polyline",
          "points": [
            ["-W / 2", "-L / 2"],
            ["W / 2", "-L / 2"],
            ["W / 2", "L / 2"],
            ["-W / 2", "L / 2"]
          ],
          "closed": true
        },
        { "kind": "circle", "c": ["-W / 4", 0], "r": "L / 2 - 30" },
        { "kind": "line", "a": ["W / 4 - W / 8", "-L / 3"], "b": ["W / 4 + W / 8", "-L / 3"] },
        { "kind": "line", "a": ["W / 4 - W / 8", "L / 3"], "b": ["W / 4 + W / 8", "L / 3"] }
      ],
      "body3d": [{ "kind": "box", "min": ["-W / 2", "-L / 2", 0], "max": ["W / 2", "L / 2", "H"] }],
      "properties": [
        { "name": "flow_rate", "label": { "ja": "吐出量", "en": "Flow rate" }, "ty": "real", "unit": "L/min", "ifc_property": "Pset_PumpTypeCommon.NominalFlowRate", "default": 200 },
        { "name": "head", "label": { "ja": "全揚程", "en": "Head" }, "ty": "real", "unit": "m", "ifc_property": "Pset_PumpTypeCommon.NominalHead", "default": 40 },
        { "name": "motor_power", "label": { "ja": "電動機出力", "en": "Motor power" }, "ty": "real", "unit": "kW", "ifc_property": "Pset_PumpTypeCommon.NominalPowerRate", "default": 2.2 },
        { "name": "tag", "label": { "ja": "機器記号", "en": "Tag" }, "ty": "text", "ifc_property": "Pset_ManufacturerTypeInformation.ModelReference", "default": "P-1" }
      ]
    },
    {
      "id": "plumbing.tank.receiving",
      "name": { "ja": "受水槽", "en": "Water storage tank" },
      "category": "plumbing-equipment",
      "tags": ["受水槽", "貯水槽", "タンク", "FRP"],
      "ifc_class": "IfcTank",
      "source": "generic",
      "parameters": [
        { "name": "W", "label": { "ja": "幅", "en": "Width" }, "default": 3000, "min": 1000, "max": 12000, "unit": "mm" },
        { "name": "L", "label": { "ja": "奥行", "en": "Depth" }, "default": 2000, "min": 1000, "max": 8000, "unit": "mm" },
        { "name": "H", "label": { "ja": "高さ", "en": "Height" }, "default": 2000, "min": 1000, "max": 4000, "unit": "mm" },
        { "name": "D", "label": { "ja": "接続口径", "en": "Connection bore" }, "default": 50, "min": 20, "max": 200, "unit": "mm" }
      ],
      "ports": [
        { "name": "inlet", "origin": ["-W / 2", 0, "H * 0.9"], "direction": [-1, 0, 0], "profile": { "kind": "round", "d": "D" }, "system_kind": "water" },
        { "name": "outlet", "origin": ["W / 2", 0, 200], "direction": [1, 0, 0], "profile": { "kind": "round", "d": "D" }, "system_kind": "water" },
        { "name": "overflow", "origin": [0, "L / 2", "H * 0.95"], "direction": [0, 1, 0], "profile": { "kind": "round", "d": "D * 1.5" }, "system_kind": "drainage" },
        { "name": "drain", "origin": [0, "-L / 2", 100], "direction": [0, -1, 0], "profile": { "kind": "round", "d": "D" }, "system_kind": "drainage" }
      ],
      "symbol2d": [
        {
          "kind": "polyline",
          "points": [
            ["-W / 2", "-L / 2"],
            ["W / 2", "-L / 2"],
            ["W / 2", "L / 2"],
            ["-W / 2", "L / 2"]
          ],
          "closed": true
        },
        {
          "kind": "polyline",
          "points": [
            ["-W / 2 + 100", "-L / 2 + 100"],
            ["W / 2 - 100", "-L / 2 + 100"],
            ["W / 2 - 100", "L / 2 - 100"],
            ["-W / 2 + 100", "L / 2 - 100"]
          ],
          "closed": true
        },
        { "kind": "circle", "c": ["W / 4", "L / 4"], "r": 300 }
      ],
      "body3d": [{ "kind": "box", "min": ["-W / 2", "-L / 2", 0], "max": ["W / 2", "L / 2", "H"] }],
      "properties": [
        { "name": "capacity", "label": { "ja": "有効容量", "en": "Effective capacity" }, "ty": "real", "unit": "m3", "ifc_property": "Pset_TankTypeCommon.NominalCapacity", "default": 10 },
        { "name": "material", "label": { "ja": "材質", "en": "Material" }, "ty": "text", "ifc_property": "Pset_TankTypeCommon.Material", "default": "FRP" }
      ]
    },
    {
      "id": "plumbing.water_heater",
      "name": { "ja": "給湯器", "en": "Water heater" },
      "category": "plumbing-equipment",
      "tags": ["給湯器", "ボイラ", "給湯", "ガス"],
      "ifc_class": "IfcBoiler",
      "source": "generic",
      "parameters": [
        { "name": "W", "label": { "ja": "幅", "en": "Width" }, "default": 480, "min": 300, "max": 1500, "unit": "mm" },
        { "name": "L", "label": { "ja": "奥行", "en": "Depth" }, "default": 250, "min": 150, "max": 900, "unit": "mm" },
        { "name": "H", "label": { "ja": "高さ", "en": "Height" }, "default": 650, "min": 400, "max": 2000, "unit": "mm" }
      ],
      "ports": [
        { "name": "cold_in", "origin": ["-100", 0, 0], "direction": [0, 0, -1], "profile": { "kind": "round", "d": 20 }, "system_kind": "water" },
        { "name": "hot_out", "origin": [0, 0, 0], "direction": [0, 0, -1], "profile": { "kind": "round", "d": 20 }, "system_kind": "water" },
        { "name": "gas", "origin": [100, 0, 0], "direction": [0, 0, -1], "profile": { "kind": "round", "d": 20 }, "system_kind": "gas" },
        { "name": "flue", "origin": [0, 0, "H"], "direction": [0, 0, 1], "profile": { "kind": "round", "d": 100 }, "system_kind": "air" },
        { "name": "power", "origin": ["W / 2", 0, "H / 2"], "direction": [1, 0, 0], "profile": { "kind": "terminal" }, "system_kind": "power" }
      ],
      "symbol2d": [
        {
          "kind": "polyline",
          "points": [
            ["-W / 2", "-L / 2"],
            ["W / 2", "-L / 2"],
            ["W / 2", "L / 2"],
            ["-W / 2", "L / 2"]
          ],
          "closed": true
        },
        { "kind": "circle", "c": [0, 0], "r": "min(W, L) / 3" }
      ],
      "body3d": [{ "kind": "box", "min": ["-W / 2", "-L / 2", 0], "max": ["W / 2", "L / 2", "H"] }],
      "properties": [
        { "name": "capacity", "label": { "ja": "号数", "en": "Rating" }, "ty": "int", "unit": "count", "ifc_property": "Pset_BoilerTypeCommon.NominalEnergyConsumption", "default": 24 },
        { "name": "heat_output", "label": { "ja": "熱出力", "en": "Heat output" }, "ty": "real", "unit": "kW", "ifc_property": "Pset_BoilerTypeCommon.NominalPartLoadRatio", "default": 41.9 },
        { "name": "fuel", "label": { "ja": "燃料", "en": "Fuel" }, "ty": "text", "ifc_property": "Pset_BoilerTypeCommon.EnergySource", "default": "都市ガス" }
      ]
    },
    {
      "id": "plumbing.water_meter",
      "name": { "ja": "量水器", "en": "Water meter" },
      "category": "plumbing-equipment",
      "tags": ["量水器", "メーター", "水道メーター"],
      "ifc_class": "IfcFlowMeter",
      "source": "generic",
      "parameters": [
        { "name": "D", "label": { "ja": "呼び径", "en": "Nominal bore" }, "default": 25, "min": 13, "max": 150, "unit": "mm" },
        { "name": "L", "label": { "ja": "面間", "en": "Face to face" }, "default": "max(D * 8, 165)", "min": 100, "unit": "mm" }
      ],
      "ports": [
        { "name": "in", "origin": [0, 0, 0], "direction": [-1, 0, 0], "profile": { "kind": "round", "d": "D" }, "system_kind": "water" },
        { "name": "out", "origin": ["L", 0, 0], "direction": [1, 0, 0], "profile": { "kind": "round", "d": "D" }, "system_kind": "water" }
      ],
      "symbol2d": [
        {
          "kind": "polyline",
          "points": [
            [0, "-D / 2"],
            ["L", "-D / 2"],
            ["L", "D / 2"],
            [0, "D / 2"]
          ],
          "closed": true
        },
        { "kind": "circle", "c": ["L / 2", 0], "r": "D * 0.8" },
        { "kind": "text", "at": ["L / 2 - D * 0.4", "D * 1.2"], "value": "M", "height": "D" }
      ],
      "body3d": [{ "kind": "cylinder", "base": [0, 0, 0], "axis": ["L", 0, 0], "radius": "D * 0.8" }],
      "properties": [
        { "name": "diameter", "label": { "ja": "呼び径", "en": "Nominal bore" }, "ty": "real", "unit": "mm", "ifc_property": "Pset_FlowMeterTypeCommon.NominalDiameter" },
        { "name": "meter_type", "label": { "ja": "形式", "en": "Meter type" }, "ty": "text", "ifc_property": "Pset_FlowMeterTypeCommon.FlowMeterPurpose", "default": "羽根車式" }
      ]
    }
  ]
}
